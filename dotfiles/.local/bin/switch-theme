#!/bin/sh

# This script allows to toggle dark and light theme.
# It also allows to set a specific theme using the 'dark' and 'light' flags.

set -e

CURR_THEME="$HOME/.theme"                        # Last theme used.
DARK_D="$HOME/.local/bin/switch-theme-dark.d"    # Dark Drop-in scripts.
LIGHT_D="$HOME/.local/bin/switch-theme-light.d"  # Light Drop-in scripts.

exec_drop_in() {
    for file in "$1"/*.sh; do
        . "$file" &
    done
}

set_dark_theme() {
    exec_drop_in $DARK_D
    echo "dark" > "$CURR_THEME"
}

set_light_theme() {
    exec_drop_in $LIGHT_D
    echo "light" > "$CURR_THEME"
}

if [ -f "$CURR_THEME" ]; then
    PREV_THEME=$(cat "$CURR_THEME")
fi

# Set the specified theme.
if [ $# -gt 0 ]; then
    if [ $1 == "prev" ]; then
        if [ -z $PREV_THEME ] || [ "$PREV_THEME" == "dark" ]; then
            set_dark_theme
        else
            set_light_theme
        fi
    elif [ $1 == "dark" ]; then
        set_dark_theme
    elif [ $1 == "light" ]; then
        set_light_theme
    else
        echo "Invalid option: $1" >&2
        exit 1
    fi

    exit 0
fi

# Toggle theme.
if [ -n "$PREV_THEME" ]; then
    if [ "$PREV_THEME" == "dark" ]; then
        set_light_theme
    else
        set_dark_theme
    fi
else
    set_dark_theme
fi
